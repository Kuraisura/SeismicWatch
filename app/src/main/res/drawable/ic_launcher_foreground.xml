<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher foreground: the SeismicWatch gradient shell + seismic waveform, kept
  inside the central safe zone so it survives circle/squircle/rounded masks. The dark
  obsidian ground is supplied by @color/ic_launcher_background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gradient rounded-square shell (red → orange, diagonal), centered in the safe zone -->
    <path android:pathData="M50,37 L58,37 Q71,37 71,50 L71,58 Q71,71 58,71 L50,71 Q37,71 37,58 L37,50 Q37,37 50,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37" android:startY="37"
                android:endX="71" android:endY="71"
                android:startColor="#FF2D55"
                android:endColor="#FF6A00" />
        </aapt:attr>
    </path>

    <!-- Seismic EKG waveform (chalk) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFF7F2F4"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M42,54 L48,54 L51,45 L56,64 L59,48 L63,58 L66,54 L68,54" />
</vector>
