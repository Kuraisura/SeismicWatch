<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are disabled app-wide (android:allowBackup="false"). These rules remain as
  defense-in-depth: even if backup is ever re-enabled, nothing leaves the device.
  SeismicWatch holds sensitive data (the encrypted DB, family links, location) that must
  never be copied to cloud backup or transferred to another device unencrypted.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
