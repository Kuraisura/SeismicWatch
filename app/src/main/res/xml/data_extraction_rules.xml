<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data-extraction rules. Backups are disabled app-wide, but we
  also exclude everything from both cloud backup and device-to-device transfer so that
  the encrypted database, secure prefs, and any cached location data never leave the
  device in a restorable form.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
